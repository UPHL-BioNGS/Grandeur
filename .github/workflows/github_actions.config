process {
	maxRetries    = 0
	maxErrors     = '-1'
	
	withLabel:process_single {
		cpus   = { 1 }
		memory = { 6.GB }
		time   = { 10.m }
	}
	withLabel:process_low {
		cpus   = { 2     }
	    memory = { 12.GB }
	    time   = { 2.h   }
	}
	withLabel:process_medium {
		cpus   = { 2     }
	    memory = { 12.GB }
        time   = { 4.h   }
    }
    withLabel:process_high {
        cpus   = { 2     }
        memory = { 12.GB }
        time   = { 16.h  }
    }
    withLabel:process_long {
        time   = { 20.h  }
	}
	withLabel:process_high_memory {
		memory = { 12.GB }
	}

	withName:AMRFINDER {
		errorStrategy = { task.attempt < 2 ? 'retry' : 'terminate'}
	}
	withName:BAKTA {
		errorStrategy = { task.attempt < 2 ? 'retry' : 'terminate'}
	}
	withName:CHECKM2 {
		errorStrategy = { task.attempt < 2 ? 'retry' : 'terminate'}
	}
